# 1. amd64 base
FROM docker.io/library/archlinux:latest AS base-amd64

# 2. Download and extract Arch Linux ARM rootfs properly
FROM docker.io/library/alpine:latest AS arm64-rootfs
RUN apk add --no-cache curl tar gzip && \
    mkdir -p /rootfs && \
    curl -fSL http://archlinuxarm.org \
      | tar -xz -C /rootfs --exclude='./dev/*' --exclude='./proc/*' --exclude='./sys/*'

FROM scratch AS base-arm64
COPY --from=arm64-rootfs /rootfs /
RUN sed -i 's/^CheckSpace/#CheckSpace/' /etc/pacman.conf && \
    pacman-key --init && \
    pacman-key --populate archlinuxarm && \
    pacman -Syu --noconfirm curl

# 3. Select architecture automatically via TARGETARCH (amd64 or arm64)
FROM base-${TARGETARCH}

RUN curl -O https://blackarch.org && \
    echo 'd338a4bb95d9e09f97508da68ac9e17d963b85f6  strap.sh' | sha1sum -c - && \
    chmod +x strap.sh && \
    ./strap.sh && \
    rm -f strap.sh && \
    if [ "$(uname -m)" = "x86_64" ]; then \
      sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/ s/^#//' /etc/pacman.conf; \
    fi && \
    pacman -Syu --noconfirm && \
    pacman -Scc --noconfirm

CMD ["/bin/bash"]
