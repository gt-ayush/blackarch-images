FROM docker.io/library/archlinux:latest AS builder

RUN curl -O https://blackarch.org/strap.sh && \
    echo 'd338a4bb95d9e09f97508da68ac9e17d963b85f6  strap.sh' | sha1sum -c - && \
    chmod +x strap.sh && \
    ./strap.sh && \
    pacman -Syu --noconfirm

RUN mkdir -p /rootfs/var/lib/pacman /rootfs/etc && \
    cp -r /etc/pacman* /rootfs/etc/ && \
    pacman -Sy --root /rootfs --noconfirm glibc openssl ca-certificates && \
    rm -rf /rootfs/var/cache/pacman/pkg/* \
           /rootfs/var/lib/pacman/sync/* \
           /rootfs/usr/share/man/* \
           /rootfs/usr/share/doc/*

FROM scratch
COPY --from=builder /rootfs /