ARG BASE_IMAGE=docker.io/library/archlinux:latest
FROM ${BASE_IMAGE} AS builder

RUN if [ "$(uname -m)" = "aarch64" ] || [ "$(uname -m)" = "arm64" ]; then \
      pacman-key --init && \
      pacman-key --populate archlinuxarm && \
      pacman -Syu --noconfirm curl libarchive gnupg coreutils; \
    else \
      pacman-key --init && \
      pacman-key --populate archlinux && \
      pacman -Syu --noconfirm curl libarchive gnupg coreutils; \
    fi && \
    curl -fsSL https://blackarch.org/strap.sh -o /tmp/strap.sh && \
    echo 'd338a4bb95d9e09f97508da68ac9e17d963b85f6  /tmp/strap.sh' | sha1sum -c - && \
    chmod +x /tmp/strap.sh && \
    /tmp/strap.sh && \
    rm -f /tmp/strap.sh && \
    if [ "$(uname -m)" = "x86_64" ]; then \
      sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/ s/^#//' /etc/pacman.conf; \
    fi && \
    pacman -Syu --noconfirm

RUN mkdir -p /rootfs/var/lib/pacman /rootfs/etc && \
    cp -r /etc/pacman* /rootfs/etc/ && \
    pacman -Sy --root /rootfs --noconfirm glibc openssl ca-certificates && \
    rm -rf /rootfs/var/cache/pacman/pkg/* \
           /rootfs/var/lib/pacman/sync/* \
           /rootfs/usr/share/man/* \
           /rootfs/usr/share/doc/*

FROM scratch
COPY --from=builder /rootfs /